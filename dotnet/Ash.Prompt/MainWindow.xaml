<Window x:Class="Ash.Prompt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ash Prompt"
        Width="980"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        Background="{StaticResource Paper}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ModelText"
                   Text="Starting the engine…"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="LayersText"
                   Grid.Column="1"
                   Foreground="{StaticResource Dim}"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="72"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="80"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Temperature" VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
        <Slider x:Name="TemperatureSlider"
                Grid.Column="1"
                Margin="12,0"
                Minimum="0"
                Maximum="2"
                SmallChange="0.1"
                LargeChange="0.5"
                TickFrequency="0.1"
                VerticalAlignment="Center"/>
        <TextBox x:Name="TemperatureBox" Grid.Column="2" Text="0.8" VerticalContentAlignment="Center"/>
        <TextBlock Text="Max tokens"
                   Grid.Column="3"
                   Margin="16,0,8,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="MaxTokensBox" Grid.Column="4" Text="1024" VerticalContentAlignment="Center"/>
        <Button x:Name="SendButton"
                Grid.Column="5"
                Content="Send"
                Margin="16,0,0,0"
                MinWidth="88"
                IsEnabled="False"
                ToolTip="Ctrl+Enter"
                Click="OnSend"/>
      </Grid>
    </StackPanel>

    <TextBlock x:Name="StatusText"
               DockPanel.Dock="Bottom"
               Text="Starting the engine…"
               Margin="0,12,0,0"
               Foreground="{StaticResource Dim}"
               TextTrimming="CharacterEllipsis"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="1.4*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <TextBlock DockPanel.Dock="Top" Text="Prompt" Margin="0,0,0,6" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="PromptBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 PreviewKeyDown="OnPromptKeyDown"/>
      </DockPanel>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Raw response" Margin="0,0,0,6" Foreground="{StaticResource Dim}"/>
        <TextBox x:Name="ResponseBox"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
